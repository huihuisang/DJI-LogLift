    "Only convert original %@ clips. Normal, HLG, or previously converted videos can produce incorrect colors.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only convert original %@ clips. Normal, HLG, or previously converted videos can produce incorrect colors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认这些视频是 %@ 模式录制、尚未转换的原片。普通模式、HLG 或已转换的视频再次还原，可能导致色彩异常。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未変換の %@ 素材のみを変換してください。通常モード、HLG、または変換済みの動画では、色が正しく表示されないことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환하지 않은 %@ 원본 영상만 변환하세요. 일반 모드, HLG 또는 이미 변환된 동영상은 색상이 잘못 표시될 수 있습니다."
          }
        }
      }
    },
    "Or add videos to start with a before-and-after preview.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
