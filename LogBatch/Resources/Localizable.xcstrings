    "Choose a folder for converted videos. Original files stay unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder for converted videos. Original files stay unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择转换后视频的保存文件夹。原始文件保持不变。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換した動画の保存先を選択してください。元のファイルは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환된 동영상의 저장 폴더를 선택하세요. 원본 파일은 변경되지 않습니다."
          }
        }
      }
    },
    "Choose a model. Its official LUT is already here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a model. Its official LUT is already here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选好机型，官方 LUT 已经就位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機種を選ぶだけ。公式 LUT は準備済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 선택하세요. 공식 LUT가 준비되어 있습니다."
          }
        }
      }
    },
    "Choose videos or a folder of DJI footage.": {
      "extractionState": "manual",
      "localizations": {
