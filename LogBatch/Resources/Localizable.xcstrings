    },
    "Choose your camera and conversion LUT, then add videos. Processing stays on your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your camera and conversion LUT, then add videos. Processing stays on your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择相机和转换 LUT，然后添加视频。所有处理均在 Mac 本地完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラと変換 LUT を選び、動画を追加してください。処理はすべて Mac 内で行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라와 변환 LUT를 선택한 후 동영상을 추가하세요. 모든 처리는 Mac에서 이루어집니다."
          }
        }
      }
    },
