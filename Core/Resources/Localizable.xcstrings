{
  "sourceLanguage": "en",
  "strings": {
    "An output file already exists. Choose another folder or rename the source.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An output file already exists. Choose another folder or rename the source."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输出文件已存在。请选择其他文件夹或重命名源文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力ファイルが存在します。別のフォルダを選ぶか、元のファイル名を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출력 파일이 이미 존재합니다. 다른 폴더를 선택하거나 원본 이름을 변경하세요."
          }
        }
      }
    },
    "Bundled LUT resources are missing or invalid.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundled LUT resources are missing or invalid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置 LUT 资源缺失或无效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵 LUT リソースが見つからないか無効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장 LUT 리소스가 없거나 유효하지 않습니다."
          }
        }
      }
    },
    "The CUBE file is incomplete or invalid.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CUBE file is incomplete or invalid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CUBE 文件不完整或无效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CUBE ファイルが不完全か無効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CUBE 파일이 불완전하거나 유효하지 않습니다."
          }
        }
      }
    },
    "The LUT file failed its integrity check.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The LUT file failed its integrity check."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LUT 文件未通过完整性校验。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LUT ファイルの整合性検証に失敗しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LUT 파일 무결성 검사에 실패했습니다."
          }
        }
      }
    },
    "This LUT format is not supported for conversion yet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This LUT format is not supported for conversion yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持使用此格式的 LUT 转换。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この LUT 形式はまだ変換に対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 LUT 형식의 변환은 아직 지원되지 않습니다."
          }
        }
      }
    },
    "This video format or track layout is not supported.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video format or track layout is not supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此视频格式或轨道结构。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この動画形式またはトラック構成には対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동영상 형식 또는 트랙 구성은 지원되지 않습니다."
          }
        }
      }
    },
    "Video processing failed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video processing failed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频处理失败。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画の処理に失敗しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상 처리에 실패했습니다."
          }
        }
      }
    }
  },
  "version": "1.0"
}
